{
  "manifest_version": 3,
  "name": "Site Maintenance Login",
  "version": "1.0.0",
  "description": "Signs you in to WordPress sites from the Claude Connector maintenance dashboard, in a new tab of your own browser.",
  "key": "",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "externally_connectable": { "matches": ["http://127.0.0.1/*", "http://localhost/*"] },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
